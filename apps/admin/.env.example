# Go API base URL (the admin routes live under /admin/v1).
VITE_API_URL=http://localhost:8085

# Customer app, linked from the admin sign-in screen.
VITE_WEB_URL=http://localhost:3000

# Same WorkOS environment as the web app. The client ID is public; never put the API key here.
VITE_WORKOS_CLIENT_ID=client_replace_me
VITE_WORKOS_REDIRECT_URI=http://localhost:3010/callback

# Production only: your WorkOS custom auth domain (e.g. auth.example.com).
VITE_WORKOS_API_HOSTNAME=

# Production without a custom auth domain: keep the sign-in in local storage so it survives a page refresh.
VITE_WORKOS_DEV_MODE=
