# Public URL of this frontend.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base URL of the Go API. Do not place secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_API_URL=http://localhost:8080

# WorkOS AuthKit. Create these in the WorkOS staging environment.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=sk_test_replace_me
# Generate at least 32 random characters; never expose this as NEXT_PUBLIC.
WORKOS_COOKIE_PASSWORD=replace_with_a_random_secret_at_least_32_characters
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
