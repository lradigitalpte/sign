{
  "name": "signing-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace web run dev",
    "build:web": "npm --workspace web run build",
    "lint:web": "npm --workspace web run lint",
    "start:web": "npm --workspace web run start",
    "dev:admin": "npm --workspace admin run dev",
    "build:admin": "npm --workspace admin run build",
    "lint:admin": "npm --workspace admin run lint"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
