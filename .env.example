APP_ENV=development
API_ADDRESS=:8085
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3010
DATABASE_URL=postgres://signing:signing@localhost:5435/signing?sslmode=disable
SHUTDOWN_TIMEOUT=10s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s

# WorkOS access-token validation for the Go API.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=sk_test_replace_me
WORKOS_ISSUER=https://api.workos.com/
WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_replace_me
# Signing secret of the webhook endpoint in the WorkOS dashboard (Developer > Webhooks), pointing at
# <API origin>/webhooks/workos. Leave empty to turn the endpoint off.
WORKOS_WEBHOOK_SECRET=
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=signing
STORAGE_SECRET_KEY=signing-development-secret
STORAGE_BUCKET=signing-documents
STORAGE_USE_SSL=false
# Base64-encoded 32-byte key used to encrypt queued signing tokens.
TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
SIGNING_ORIGIN=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Signing Platform <noreply@localhost>
# If RESEND_API_KEY is set, the worker sends through Resend instead of SMTP.
RESEND_API_KEY=
RESEND_FROM=Signing Platform <onboarding@resend.dev>
EMAIL_PREVIEW_ADDRESS=:8090
EMAIL_PREVIEW_DIR=var/email-previews
# Stripe takes payments for paid plans. Use test keys (sk_test_...) outside production.
# Webhook endpoint: <API origin>/webhooks/stripe, with events checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.paid and invoice.payment_failed.
# Locally: stripe listen --forward-to localhost:8085/webhooks/stripe, then use the whsec_ it prints.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
